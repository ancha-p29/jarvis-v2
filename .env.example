# Copy this file to ".env" or set these as environment variables.
# NEVER commit your real .env to GitHub. It is in .gitignore for a reason.

# --- Twilio (only needed for REAL phone calls) ---
# Sign up at twilio.com, buy a US number (about $1.15/month),
# calls cost about $0.014/minute in the US.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL where phone_server.py is reachable.
# Dev: run "ngrok http 8765" and paste the https URL it gives you.
# Then set your Twilio number's Voice webhook to: <PUBLIC_BASE_URL>/voice
PUBLIC_BASE_URL=

# --- Optional: protect POST /api/call-me ---
JARVIS_API_SECRET=

# --- Optional: Sarvam AI (Saaras STT / Bulbul TTS, from the reel) ---
# Only needed if you swap Twilio's built-in speech for Sarvam's
# Indian-language voices. The default phone flow does NOT need this.
SARVAM_API_KEY=

# --- Optional: phone server port (defaults to config.yaml phone.port) ---
PORT=
